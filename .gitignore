# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 로컬 목업 데이터 (DB 미사용 시 자동 생성)
/data/*.json

# env
.env
.env.local

# large local archive (exceeds GitHub's file size limit)
/profiles-project.zip
